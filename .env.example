# Sticky local configuration.
# Copy to .env for docker compose, or export the variables in your shell.
# No API keys are required.

# Backend
STICKY_DATA_DIR=/tmp/sticky-data
STICKY_MAX_UPLOAD_MB=25
STICKY_MAX_MEGAPIXELS=40
STICKY_PREVIEW_MAX_DIMENSION=1400
STICKY_FINAL_MAX_DIMENSION=4096
STICKY_VECTOR_MAX_DIMENSION=1200
STICKY_ARTIFACT_TTL_HOURS=6
STICKY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STICKY_SEGMENTATION_BACKEND=opencv
# rembg is optional, off by default, and downloads model weights on first use.
STICKY_ENABLE_REMBG=false
STICKY_JOB_WORKERS=2

# Frontend (baked in at `next build` / `next dev` time)
NEXT_PUBLIC_API_URL=http://localhost:8000
