{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "services/api/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "services/api", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@sticky/web"],
      "port": 3000
    }
  ]
}
